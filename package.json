{
  "name": "facepulse",
  "productName": "FacePulse",
  "version": "1.1.5",
  "description": "Programada por Rodrigo Cancino",
  "main": "src/index.js",
  "scripts": {
    "test:js": "jest",
    "freeze": "py -m pip install -r requeriments.txt && py -m PyInstaller src/python/asistencia.py --onefile --name facepulse-asistencia --distpath bin --add-data \"src/assets/weights;weights\" --collect-all mediapipe --collect-all cv2 && py -m PyInstaller src/python/registerv2.py --onefile --name facepulse-register --distpath bin --add-data \"src/assets/weights;weights\" --collect-all mediapipe --collect-all cv2",
    "prebuild": "npm run freeze",
    "build": "electron-builder --win portable --x64",
    "build-only": "electron-builder --win portable --x64",
    "dev": "electron .",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "build": {
    "appId": "com.tuapp.id",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "bin/facepulse-asistencia.exe",
      "bin/facepulse-register.exe"
    ],
    "extraResources": [
      {
        "from": "src/assets/weights",
        "to": "weights"
      },
      {
        "from": "bin/facepulse-asistencia.exe",
        "to": "facepulse-asistencia.exe"
      },
      {
        "from": "bin/facepulse-register.exe",
        "to": "facepulse-register.exe"
      }
    ],
    "win": {
      "icon": "path/to/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
    "requestExecutionLevel": "user",
    "customNsisBinary": {
      "url": "https://github.com/SoundSafari/NSISBI-ElectronBuilder/releases/download/1.0.0/nsisbi-electronbuilder-3.10.3.7z",
      "checksum": "WRmZUsACjIc2s7bvsFGFRofK31hfS7riPlcfI1V9uFB2Q8s7tidgI/9U16+X0I9X2ZhNxi8N7Z3gKvm6ojvLvg=="   
    }
  }
  },
  "dependencies": {
    "@firebasegen/default-connector": "file:dataconnect-generated/js/default-connector",
    "chart.js": "^4.4.9",
    "electron-squirrel-startup": "^1.0.1",
    "firebase": "^11.6.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "node-fetch": "^2.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@types/jest": "^29.5.14",
    "electron": "35.1.0",
    "electron-builder": "^26.0.12",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "ts-jest": "^29.4.0"
  },
  "author": {
    "name": "rass4k",
    "email": "rodrigo.cancino2001@gmail.com"
  },
  "license": "MIT"
}
